managed;
strict ( 2 );

define behavior for zan_I_so_head implementation in class zbp_an_i_so_head unique
persistent table zan_so_header
lock master
authorization master ( instance )
etag master LastChangedAt
early numbering
{
  create ( authorization : global );
  update;
  delete;
  field ( readonly ) SoId, TotalPrice, Currency ;
  field ( mandatory : create ) Vtweg;
  field ( mandatory : update ) Vtweg;
  association _item { create; }
  internal action CalTotPrice;
  determination CalPrice on modify { create; field TotalPrice, Currency; }
  validation validate_vkorg on save { create; update; field Vkorg; }

  mapping for zan_so_header
    {
      SoId          = so_id;
      Kunnr         = kunnr;
      Vkorg         = vkorg;
      Vtweg         = vtweg;
      Spart         = spart;
      TotalPrice    = total;
      Currency      = currency;
      LastChangedAt = last_changed_at;
    }
}

define behavior for zan_i_so_item //alias <alias_name>
implementation in class zcl_bp_so_item unique
persistent table zan_so_item
lock dependent by _head
authorization dependent by _head
early numbering

//etag master <field_name>
{
  update;
  delete;
  field ( readonly ) SoId, Posnr;
  association _head;
  determination CalPrice on modify { create; field Netpr, Currency; }
  mapping for zan_so_item
    {
      SoId     = so_id;
      Posnr    = posnr;
      Matnr    = matnr;
      Menge    = menge;
      Uom      = uom;
      Netpr    = netpr;
      Currency = currency;
    }
}